        {
          "id": "/page/0/Text/4",
          "block_type": "Text",
          "html": "<p block-type=\"Text\">This document has been endorsed by the Medical Device Coordination Group (MDCG)  established by Article 103 of Regulation (EU) 2017/745. The MDCG is composed of  representatives of all Member States and it is chaired by a representative of the  European Commission.</p>",
          "polygon": [
            [
              67.48718546139503,
              603.8486641181545
            ],
            [
              527.8681659073914,
              603.8486641181545
            ],
            [
              527.8681659073914,
              667.8600006103516
            ],
            [
              67.48718546139503,
              667.8600006103516
            ]
          ],
          "bbox": [
            67.48718546139503,
            603.8486641181545,
            527.8681659073914,
            667.8600006103516
          ],
          "children": null,
          "section_hierarchy": {
            "1": "/page/0/SectionHeader/2"
          },
          "images": {}
        },
        {
          "id": "/page/0/Text/5",
          "block_type": "Text",
          "html": "<p block-type=\"Text\">The document is not a European Commission document and it cannot be regarded as  reflecting the official position of the European Commission. Any views expressed in  this document are not legally binding and only the Court of Justice of the European  Union can give binding interpretations of Union law.</p>",
          "polygon": [
            [
              67.50409685033995,
              676.3314613349079
            ],
            [
              528.3356601513302,
              676.3314613349079
