        {
          "id": "/page/0/SectionHeader/2",
          "block_type": "SectionHeader",
          "html": "<h1><b>MDCG 2026-4</b> <b>MDCG Position Paper:</b> <b>Management of SS(C)P in EUDAMED</b> <b>after mandatory use</b></h1>",
          "polygon": [
            [
              103.11605158500767,
              243.57781765021497
            ],
            [
              526.8767335829266,
              243.57781765021497
