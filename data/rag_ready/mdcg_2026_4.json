        {
          "id": "/page/0/Text/3",
          "block_type": "Text",
          "html": "<p block-type=\"Text\"><b>June 2026</b></p>",
          "polygon": [
            [
              103.84577830432343,
              488.48563896580026
            ],
            [
              185.05155349078046,
              488.48563896580026
