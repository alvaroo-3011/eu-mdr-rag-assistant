            {
              "id": "/page/1/ListItem/208",
              "block_type": "ListItem",
              "html": "<li block-type=\"ListItem\"> the qualification requirements of notified body personnel laid down in Annex VII  (sections 3.2.1 and 3.2.5) and</li>",
              "polygon": [
